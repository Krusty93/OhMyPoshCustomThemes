{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "console_title_template": "{{if .Root}}(Admin) {{end}}{{.Folder}}",
  "final_space": true,
  "upgrade": {
    "notice": true,
    "interval": "168h",
    "auto": false,
    "source": "cdn"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "foreground": "#242424",
          "powerline_symbol": "",
          "template": "",
          "background": "#f1184c",
          "type": "root",
          "style": "powerline"
        },
        {
          "options": {
            "display_distro_name": true
          },
          "leading_diamond": " ",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "foreground": "#3A86FF",
          "background": "#282c34",
          "type": "os",
          "style": "diamond"
        },
        {
          "options": {
            "time_format": "15:04"
          },
          "template": "{{ .CurrentDate | date .Format }} ",
          "foreground": "#FFBB00",
          "powerline_symbol": "",
          "background": "#242424",
          "type": "time",
          "style": "powerline"
        },
        {
          "options": {
            "max_depth": 2,
            "style": "agnoster_short"
          },
          "template": "\ue5ff {{ .Path }} ",
          "foreground": "#ffffff",
          "powerline_symbol": "",
          "background": "#242424",
          "type": "path",
          "style": "powerline"
        },
        {
          "options": {
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "source": "cli",
            "github_icon": "\uEA84"
          },
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FFEB3B{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#FFCC80{{ end }}",
            "{{ if gt .Ahead 0 }}#B388FF{{ end }}",
            "{{ if gt .Behind 0 }}#B388FB{{ end }}"
          ],
          "template": "{{ .UpstreamIcon }}  {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }}",
          "powerline_symbol": "",
          "background": "#242424",
          "type": "git",
          "style": "powerline"
        },
        {
          "template": " {{ .Name }}",
          "powerline_symbol": "",
          "foreground": "#000000",
          "background": "#9ec3f0",
          "type": "az",
          "style": "powerline"
        },
        {
          "type": "copilot",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#111111",
          "background": "#fee898",
          "template": "  {{ .Premium.Percent.Gauge }} ",
          "cache": {
            "duration": "5m",
            "strategy": "session"
          },
          "options": {
            "http_timeout": 1000
          }
        },
        {
          "options": {
            "style": "austin",
            "threshold": 1000
          },
          "template": " <#fefefe></> {{ .FormattedMs }} ",
          "foreground": "#ffffff",
          "powerline_symbol": "",
          "background": "#8800dd",
          "type": "executiontime",
          "style": "powerline"
        },
        {
          "type": "status",
          "style": "diamond",
          "foreground": "#ffffff",
          "background": "#00897b",
          "background_templates": ["{{ if .Error }}#e91e63{{ end }}"],
          "trailing_diamond": "",
          "template": "<#193549></>  ",
          "options": {
            "always_enabled": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "➜ ",
          "foreground": "#f1184c",
          "type": "text",
          "style": "plain"
        }
      ],
      "newline": true
    }
  ]
}
